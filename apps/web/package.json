{
  "name": "@relife/web",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,magenta \"npm:web\" \"npm:worker\"",
    "web": "next dev -H 127.0.0.1 -p 3030",
    "worker": "tsx watch --env-file=../../.env src/worker/index.ts",
    "build": "next build",
    "start": "concurrently -k -n web,worker \"next start -H 127.0.0.1 -p 3030\" \"tsx --env-file=../../.env src/worker/index.ts\"",
    "service": "scripts/service.sh",
    "db:push": "drizzle-kit push",
    "dev:mock": "npm run mock:seed && RELIFE_MOCK=1 next dev -H 127.0.0.1 -p 3001",
    "mock:seed": "tsx --env-file=../../.env scripts/mock.ts",
    "seed:demo": "tsx --env-file=../../.env scripts/seed-demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file=../../.env --test src/domain/*.test.ts src/core/*.test.ts src/core/auth/*.test.ts src/connectors/shop/*.test.ts src/ai/*.test.ts src/parsers/*.test.ts src/worker/*.test.ts src/connectors/*.test.ts src/rules/*.test.ts",
    "test:auth": "RELIFE_MOCK=1 RELIFE_AUTH_INTEGRATION=1 tsx --env-file=../../.env --test src/core/auth/auth.integration.test.ts",
    "signin": "tsx --env-file=../../.env scripts/signin.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.138",
    "@ai-sdk/google": "^3.0.141",
    "@ai-sdk/openai": "^3.0.137",
    "@ai-sdk/openai-compatible": "^2.0.90",
    "@floating-ui/dom": "^1.8.0",
    "@next/env": "16.4.5",
    "@relife/brand": "*",
    "@relife/contract": "*",
    "@relife/tokens": "*",
    "ai": "^6.0.323",
    "ccxt": "^4.5.92",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "croner": "^11.0.0",
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.46.0",
    "lucide-react": "^1.69.0",
    "motion": "^14.9.1",
    "next": "16.4.5",
    "playwright-core": "^1.65.0",
    "postgres": "^4.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "rrule": "^2.8.1",
    "tailwind-merge": "^3.7.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.5",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
