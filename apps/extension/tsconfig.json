{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": [
      "chrome"
    ],
    "moduleDetection": "force"
  },
  "include": [
    "*.js",
    "globals.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
