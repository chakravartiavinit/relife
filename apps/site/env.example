# Waitlist database: its own Postgres, never the user-data one.
SITE_DATABASE_URL=postgres://relife:relife@localhost:5442/relife_site
# Production (serverless): use the pooled URL; transaction-mode poolers work (the client sets prepare: false).
# HMAC key for IP and email hashes. Required in every production run (also a local preview build); any long random string.
WAITLIST_SECRET=change-me
# Public origin used in emails, canonical URLs and the referral link.
NEXT_PUBLIC_SITE_URL=http://localhost:3040
# console prints the email with its live link: dev and local preview only, refused on Vercel.
# resend sends it. In production EMAIL_DRIVER must be set; there is no default.
EMAIL_DRIVER=console
EMAIL_FROM=ReLife <hello@example.com>
RESEND_API_KEY=
# Vercel Cron sends this as a bearer token to /api/cron/cleanup
CRON_SECRET=
# Optional Cloudflare Turnstile (off by default). Set both: the widget shows when the site key is set and
# every signup is verified when the secret is set.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Shown only when set. Leave empty until the repo is public and the license is chosen.
NEXT_PUBLIC_REPO_URL=
NEXT_PUBLIC_LICENSE_LABEL=
# Allow `next build` while packages/brand publicReady is false (local preview only; refused when VERCEL_ENV=production).
# SITE_ALLOW_UNREADY_BRAND=1
