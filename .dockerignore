# The image never contains your keys, data or git history.
**/node_modules
**/.next
.git
**/.env*
!.env.example
# Runtime state at the repo root and in apps/*; a source folder that happens to be called data (src/core/data) stays in.
/data/
apps/*/data/
apps/mac
docs
plans
.claude
.agents
*.log
# The extension and the site are built elsewhere; npm only needs their package.json to read the lockfile.
apps/extension/*
!apps/extension/package.json
apps/site/*
!apps/site/package.json
