#!/bin/sh
# Typecheck and tests must pass before anything leaves this machine.
set -e
echo "pre-push: typecheck" >&2
npm run --silent typecheck
echo "pre-push: tokens and brand" >&2
npm run --silent tokens -- --check
npm run --silent brand:check
echo "pre-push: tests" >&2
npm test --silent > /tmp/relife-prepush.log 2>&1 || { tail -30 /tmp/relife-prepush.log >&2; echo "Tests failed. Push blocked." >&2; exit 1; }

# Mac app and the shared contract fixtures: only where Swift exists and only when they changed.
if [ "$(uname)" = "Darwin" ] && [ -f apps/mac/Package.swift ] && command -v swift >/dev/null 2>&1; then
  upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || echo origin/main)
  if git diff --name-only "$upstream"...HEAD 2>/dev/null | grep -qE '^(apps/mac/|packages/contract/fixtures/)'; then
    echo "pre-push: swift test" >&2
    swift test --package-path apps/mac >/tmp/relife-prepush-swift.log 2>&1 || { tail -30 /tmp/relife-prepush-swift.log >&2; echo "swift test failed. Push blocked." >&2; exit 1; }
  fi
fi
