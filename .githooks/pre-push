#!/bin/sh
# Typecheck and tests must pass before anything leaves this machine.
set -e
echo "pre-push: typecheck" >&2
npm run --silent typecheck
echo "pre-push: tokens and brand" >&2
npm run --silent tokens -- --check
npm run --silent brand:check
echo "pre-push: migrations" >&2
# A schema.ts change needs its generated migration (apps/web/drizzle). Generate under a time limit with no terminal: a
# rename question can't be answered here, so it times out (or errors) and fails with the same message.
if command -v timeout >/dev/null 2>&1; then limit="timeout 60"; else limit=""; fi
# Migration files that exist but are not committed would pass the check below and never reach the push.
if [ -n "$(git status --porcelain apps/web/drizzle)" ]; then
  git status --short apps/web/drizzle >&2
  echo "Uncommitted files in apps/web/drizzle: commit (or remove) them first. Push blocked." >&2
  exit 1
fi
rc=0
(cd apps/web && $limit npx drizzle-kit generate </dev/null >/tmp/relife-prepush-drizzle.log 2>&1) || rc=$?
if [ "$rc" -ne 0 ] || [ -n "$(git status --porcelain apps/web/drizzle)" ]; then
  tail -5 /tmp/relife-prepush-drizzle.log >&2
  echo "Schema changed: run \`npm run db:generate\` and commit apps/web/drizzle. Push blocked." >&2
  [ "$rc" -eq 0 ] && echo "(The migration just generated is in apps/web/drizzle: review it, then commit.)" >&2
  exit 1
fi
echo "pre-push: tests" >&2
npm test --silent > /tmp/relife-prepush.log 2>&1 || { tail -30 /tmp/relife-prepush.log >&2; echo "Tests failed. Push blocked." >&2; exit 1; }

# Mac app and the shared contract fixtures: only where Swift exists and only when they changed.
if [ "$(uname)" = "Darwin" ] && [ -f apps/mac/Package.swift ] && command -v swift >/dev/null 2>&1; then
  upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || echo origin/main)
  if git diff --name-only "$upstream"...HEAD 2>/dev/null | grep -qE '^(apps/mac/|packages/contract/fixtures/)'; then
    echo "pre-push: swift test" >&2
    swift test --package-path apps/mac >/tmp/relife-prepush-swift.log 2>&1 || { tail -30 /tmp/relife-prepush-swift.log >&2; echo "swift test failed. Push blocked." >&2; exit 1; }
  fi
fi
