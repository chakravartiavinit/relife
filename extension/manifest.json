{
  "manifest_version": 3,
  "name": "ReLife",
  "version": "0.4.0",
  "description": "Sends your focused time on sites, YouTube and courses to your own ReLife, on this computer.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ReLife"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "idle",
    "alarms",
    "storage",
    "favicon"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "incognito": "not_allowed"
}
