# Copy to .env. Only DATABASE_URL is required.
# Connect services on the Connectors page (keys are stored encrypted). Connector values set here only
# prefill fields you leave blank in the Connect dialog; nothing syncs until you connect it.

# ── Core ──────────────────────────────────────────────────────────────
# Prefer a vault? Keep these in dotsafe and start with `npm run dev:vault` (docs/CONNECTORS.md).
DATABASE_URL=postgres://relife:relife@localhost:5442/relife
RELIFE_USER_NAME=
RELIFE_TIMEZONE=Asia/Kolkata
RELIFE_BASE_CURRENCY=INR
# Optional: 32-byte base64 key that encrypts saved connector keys. Default: data/secret.key, created on
# first use. Generate: openssl rand -base64 32
RELIFE_SECRET_KEY=
# Biggest ZIP (Apple Health, Google Takeout) You > Connections > Import a file accepts, in MB (default 2048).
# A reverse proxy in front must allow 16 MB request bodies (docs/IMPORTS.md). CSV files are capped at 25 MB.
# RELIFE_IMPORT_MAX_MB=2048

# ── Docker (docs/SELF_HOSTING.md) ─────────────────────────────────────
# Compose reads these from .env. Inside the containers DATABASE_URL, NODE_ENV and the data folder are set by
# docker-compose.yml, so the DATABASE_URL above (localhost:5442, for `npm run dev`) stays as it is.
# `app` runs ReLife itself, `ai` adds a local model, `demo` a read-only demo. Empty: only Postgres, for development.
# COMPOSE_PROFILES=app
# POSTGRES_PASSWORD=relife
# 127.0.0.1 = this computer only; 0.0.0.0 = your network (then set RELIFE_ALLOWED_HOSTS)
# RELIFE_LISTEN=127.0.0.1
# RELIFE_PORT=3030
# Host names or addresses you open ReLife on, besides localhost and *.ts.net. Restart after changing it.
# RELIFE_ALLOWED_HOSTS=
# The address a phone should open (QR codes and sign-in links)
# RELIFE_PUBLIC_URL=
# The local model the `ai` profile downloads and Setup offers
# RELIFE_LOCAL_AI_MODEL=qwen3:4b-instruct
# RELIFE_IMAGE=relife:local

# ── Backups (Settings → Data & privacy; npm run backup / restore) ─────
# A nightly job (03:30) and `npm run backup` write one .tar.gz: pg_dump plus secret.key, vapid.json and library covers.
# Folder for the archives. Default: backups/ at the repo root. A relative path is read from the repo root.
RELIFE_BACKUP_DIR=
# How many daily backups to keep (plus the newest of the 4 weeks before them). 0 turns backups off. Default 7.
RELIFE_BACKUP_KEEP=
# Encrypts every backup (AES-256-GCM). Without it a backup is plain and holds secret.key. A lost passphrase is a lost backup.
RELIFE_BACKUP_PASSPHRASE=
# Folder with pg_dump and pg_restore (PostgreSQL 16 or newer), if they are not on PATH. Mac: brew install libpq
RELIFE_PG_BIN=

# ── Telegram reminders (docs/CONNECTORS.md) ───────────────────────────
TELEGRAM_BOT_TOKEN=
# Send /start to your bot to get this. The bot ignores every other chat.
TELEGRAM_ALLOWED_CHAT_ID=

# ── AI, bring your own key. Format: provider:model ────────────────────
# Providers: anthropic, openai, google, openrouter, local (Ollama / LM Studio)
LLM_DEFAULT=
# Optional per-task overrides, e.g. a local model for parsing bank SMS
LLM_PARSE=
LLM_PLAN=
LLM_CHAT=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
LOCAL_LLM_URL=http://localhost:11434/v1
# The model setup offers for the free local AI, and what the app checks Ollama has (default qwen3:4b-instruct)
# RELIFE_LOCAL_AI_MODEL=qwen3:4b-instruct
# Account numbers and UPI handles are masked in prompts unless this is false
LLM_MASK=true

# ── Binance (read-only key, IP-restricted) ────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Optional: quote assets to scan for trades, extra pairs to always sync
BINANCE_QUOTES=
BINANCE_SYMBOLS=

# ── GitHub (fine-grained token, read-only) ────────────────────────────
GITHUB_TOKEN=
GITHUB_USER=

# Lichess and Chess.com: just your public username (Connectors page or here)
LICHESS_USERNAME=
CHESSCOM_USERNAME=

# Laptop activity: a token the Chrome extension can use right away (it stays a device on Settings → Devices;
# new extensions connect by QR or code instead); ACTIVITY_APPS=off to skip Mac apps
ACTIVITY_TOKEN=
ACTIVITY_APPS=

# Competitive programming: public handles only
CODEFORCES_HANDLE=
CODECHEF_HANDLE=
ATCODER_HANDLE=
LEETCODE_USERNAME=

# ── Personal data connectors (docs/CONNECTORS.md#personal-data-connectors) ──
# Sign-in connectors: your own app's client ID and secret; then press "Sign in" on Connectors
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Optional: a pasted refresh token, used until you sign in (no browser on this machine)
STRAVA_REFRESH_TOKEN=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# WHOOP accepts only https redirect addresses
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
WAKATIME_API_KEY=
MONKEYTYPE_APE_KEY=
# Duolingo: just your public username
DUOLINGO_USERNAME=
TODOIST_API_TOKEN=
LASTFM_USERNAME=
LASTFM_API_KEY=
# Steam: a Web API key and your profile link or 17-digit Steam ID (Game details must be public)
STEAM_API_KEY=
STEAM_ID=
TOGGL_API_TOKEN=
RESCUETIME_API_KEY=
# Hevy needs Hevy Pro
HEVY_API_KEY=
READWISE_TOKEN=
# Public usernames, no key
CODEWARS_USERNAME=
LETTERBOXD_USERNAME=
OPENLIBRARY_USERNAME=
# Anki: the AnkiConnect add-on; blank means http://127.0.0.1:8765
ANKI_CONNECT_URL=
ANKI_CONNECT_KEY=

# ── Gmail (bank alerts, order emails). Run: npx tsx --env-file=.env scripts/gmail-auth.ts
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_QUERY=

# ── iPhone Shortcuts inbox (docs/SHORTCUTS.md) ────────────────────────
# Default: ~/Library/Mobile Documents/com~apple~CloudDocs/relife/inbox.txt
ICLOUD_INBOX_PATH=
# For direct POST /api/ingest over Tailscale. Generate: openssl rand -hex 32
INGEST_TOKEN=
# Other addresses allowed to open ReLife besides 127.0.0.1, localhost and *.ts.net (Tailscale), comma-separated,
# e.g. a Cloudflare Tunnel name. Any other Host is refused, which blocks DNS-rebinding attacks from web pages.
# Setting this turns off "trust this Mac": every browser, this Mac's too, connects by QR or code (`npm run signin`).
# Never use a tunnel or proxy that rewrites Host to localhost: every visitor would look like this Mac.
RELIFE_ALLOWED_HOSTS=
# The address the server listens on. `npm run dev`, `npm start` and `npm run service` pass it to `next -H` (default
# 127.0.0.1), so set it in the shell, not only here: RELIFE_BIND=0.0.0.0 npm start. The app also reads it to decide
# whether "trust this Mac" is safe: when it is unset or anything but loopback, that trust is off (a client can fake
# the proxy headers, so a server that may be open to the network must not hand out sessions). Starting `next` yourself
# with -H 0.0.0.0 and no RELIFE_BIND is therefore safe, but every browser then connects by pairing too.
# RELIFE_BIND=127.0.0.1

# Optional: the address your phone opens ReLife at (e.g. https://your-mac.tailnet.ts.net, no trailing path). Telegram
# messages then get an "Open in ReLife" button. Leave empty and they stay text-only. A host that is not *.ts.net
# must also be in RELIFE_ALLOWED_HOSTS, or the button opens a refused page.
RELIFE_PUBLIC_URL=

# Optional: VAPID keys for web push (browser notifications). Leave empty and ReLife makes data/vapid.json on first use.
# Set them to keep push working after moving to a new machine (new keys invalidate every browser's subscription). In Docker
# the file is /data/vapid.json, kept in the volume and in backups.
# Make a pair with: npx web-push generate-vapid-keys
RELIFE_VAPID_PUBLIC_KEY=
RELIFE_VAPID_PRIVATE_KEY=

# ── Alerts ────────────────────────────────────────────────────────────
# Telegram alert when any bank balance drops below this (base currency)
LOW_BALANCE_ALERT=

# Shopping apps log in through your installed Chrome. Only needed if Chrome isn't in the default place.
CHROME_PATH=

# ── Sign-in and devices (Settings → Devices) ──
# self-host (default): the Mac this runs on is trusted; every other device connects by QR or code.
# RELIFE_MODE=self-host
# The address a phone should open when you scan the QR code (default: this Mac's Tailscale name).
# RELIFE_PUBLIC_URL=https://your-mac.your-tailnet.ts.net
