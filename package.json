{
  "name": "relife",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "web": "npm run web -w apps/web",
    "worker": "npm run worker -w apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "service": "npm run service -w apps/web --",
    "signin": "npm run signin -w apps/web --",
    "db:push": "npm run db:push -w apps/web",
    "dev:vault": "dotsafe run -- env RELIFE_SECRETS=dotsafe npm run dev",
    "dev:mock": "npm run dev:mock -w apps/web",
    "mock:seed": "npm run mock:seed -w apps/web --",
    "seed:demo": "npm run seed:demo -w apps/web --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "tokens": "node packages/tokens/build.mjs",
    "brand": "node packages/brand/build.mjs",
    "brand:swift": "node packages/brand/swift.mjs",
    "brand:check": "node packages/brand/check.mjs",
    "contract:check": "npm test -w @relife/contract",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "engines": {
    "node": ">=20.9"
  }
}
